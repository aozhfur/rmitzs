{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#rmit-university-diploma","title":"\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u6bd5\u4e1a\u8bc1(RMIT University Diploma)\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u9632\u4f2a\u5c42\u7ea7\u6280\u672f","text":"<p>\u5728\u5f53\u4eca\u5168\u7403\u5316\u7684\u4eba\u624d\u6d41\u52a8\u4e0e\u5b66\u5386\u9a8c\u8bc1\u4f53\u7cfb\u4e2d\uff0c\u6d77\u5916\u9ad8\u6821\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u4e0d\u4ec5\u662f\u6bd5\u4e1a\u751f\u5b66\u672f\u6210\u5c31\u7684\u81f3\u9ad8\u8c61\u5f81\uff0c\u66f4\u662f\u5404\u5927\u8de8\u56fd\u4f01\u4e1a\u3001\u653f\u5e9c\u673a\u5173\u4ee5\u53ca\u7559\u670d\u8ba4\u8bc1\u673a\u6784\u91cd\u70b9\u5ba1\u67e5\u7684\u6838\u5fc3\u51ed\u8bc1\u3002\u4f5c\u4e3a\u4eab\u8a89\u56fd\u9645\u7684\u6fb3\u6d32\u53cc\u5143\u5236\u516c\u7acb\u5927\u5b66\uff0c\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\uff08RMIT University\uff09\u5176\u9881\u53d1\u7684\u6bd5\u4e1a\u8bc1\u4e66\u5728\u6392\u7248\u827a\u672f\u3001\u6750\u6599\u5de5\u827a\u4ee5\u53ca\u5b89\u5168\u9632\u4f2a\u9886\u57df\u4e00\u76f4\u8d70\u5728\u5168\u7403\u9ad8\u7b49\u6559\u80b2\u754c\u7684\u524d\u6cbf\u3002</p> <p></p> <p>\u968f\u7740\u6570\u5b57\u5316\u4e0e\u9ad8\u7cbe\u7ec6\u5370\u5237\u6280\u672f\u7684\u6f14\u53d8\uff0c\u7eb8\u8d28\u8bc1\u4e66\u7684\u9632\u4f2a\u7ef4\u5ea6\u5df2\u4ece\u4f20\u7edf\u7684\u5355\u4e00\u89c6\u89c9\u8bc6\u522b\u5168\u9762\u5347\u7ea7\u4e3a\u591a\u5c42\u7ea7\u3001\u7acb\u4f53\u5316\u7684\u7efc\u5408\u7269\u7406\u9632\u5fa1\u4f53\u7cfb\u3002\u5176\u4e2d\uff0c\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u9632\u4f2a\u5c42\u7ea7\u6280\u672f\u4e0e\u4e13\u6709\u51f8\u538b\u5de5\u827a\u7684\u7ed3\u5408\uff0c\u6210\u4e3a\u4e86\u8bc6\u522bRMIT University\u6bd5\u4e1a\u8bc1\u771f\u4f2a\u7684\u6838\u5fc3\u7269\u7406\u9632\u7ebf\u3002\u672c\u6587\u5c06\u4ece\u641c\u7d22\u5f15\u64ce\u9ad8\u9891\u5173\u6ce8\u7684\u5b8f\u89c2\u8d8b\u52bf\u3001\u6838\u5fc3\u5de5\u827a\u67b6\u6784\u3001\u7269\u7406\u4e0e\u6570\u5b57\u53cc\u8f68\u9a8c\u8bc1\u7b49\u591a\u4e2a\u7ef4\u5ea6\uff0c\u6df1\u5ea6\u5256\u6790\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u6587\u51ed\u7684\u6838\u5fc3\u9632\u4f2a\u903b\u8f91\u3002</p>"},{"location":"#rmit","title":"\u6fb3\u6d32\u5927\u5b66\u6bd5\u4e1a\u8bc1\u9632\u4f2a\u6280\u672f\u6f14\u53d8\u4e0eRMIT\u8bbe\u8ba1\u7f8e\u5b66","text":"<p>\u4ece\u641c\u7d22\u5f15\u64ce\u7684\u5b8f\u89c2\u68c0\u7d22\u8d8b\u52bf\uff08Google Trends &amp; \u767e\u5ea6\u6307\u6570\uff09\u6765\u770b\uff0c\u201c\u6fb3\u6d32\u5927\u5b66\u6bd5\u4e1a\u8bc1\u9632\u4f2a\u201d\u3001\u201c\u6d77\u5916\u6587\u51ed\u6750\u8d28\u201d\u4ee5\u53ca\u201cRMIT\u6bd5\u4e1a\u8bc1\u7248\u672c\u66f4\u65b0\u201d\u59cb\u7ec8\u662f\u7559\u5b66\u751f\u3001HR\u548c\u8de8\u56fd\u730e\u5934\u5173\u6ce8\u7684\u9ad8\u9891\u8bcd\u6c47\u3002\u8fd9\u53cd\u6620\u51fa\u5e02\u573a\u5bf9\u6d77\u5916\u9ad8\u4ef7\u503c\u5b66\u672f\u51ed\u8bc1\u5b89\u5168\u6027\u7684\u957f\u671f\u521a\u9700\u3002</p> <p>\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u5728\u8bc1\u4e66\u8bbe\u8ba1\u4e0a\u6df1\u523b\u79c9\u627f\u4e86\u5176\u201c\u6280\u672f\u3001\u8bbe\u8ba1\u4e0e\u4f01\u4e1a\u201d\u7684\u7acb\u6821\u6838\u5fc3\u3002RMIT\u7684\u6b63\u5f0f\u6bd5\u4e1a\u8bc1\u4e66\u6574\u4f53\u98ce\u683c\u6781\u5176\u4e25\u8c28\u3001\u6d17\u7ec3\uff0c\u901a\u5e38\u91c7\u7528\u4f20\u7edf\u800c\u6b63\u5f0f\u7684\u91cd\u8d28\u975e\u6d82\u5e03\u9632\u4f2a\u8bc1\u5238\u7eb8\uff08Secure Parchment Paper\uff09\uff0c\u65e2\u4fdd\u7559\u4e86\u7ecf\u5178\u7684\u5b66\u672f\u7f8a\u76ae\u7eb8\u8d28\u611f\uff0c\u53c8\u5177\u5907\u6781\u9ad8\u7684\u7269\u7406\u8010\u78e8\u635f\u4e0e\u6297\u8001\u5316\u6027\u80fd\u3002</p> <p>\u5728\u8bc1\u4e66\u7684\u89c6\u89c9\u6392\u7248\u4e0a\uff0c\u9876\u90e8\u5c45\u4e2d\u5370\u6709\u6781\u5176\u7cbe\u81f4\u7684\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u5f69\u8272\u5168\u5f69\u76fe\u5fbd\uff08Crest\uff09\uff0c\u4e0b\u65b9\u5219\u4ee5\u7cbe\u7ec6\u7684\u9ed1\u4f53\u827a\u672f\u5b57\u6807\u660e\u201cROYAL MELBOURNE INSTITUTE OF TECHNOLOGY\u201d\u3002\u8bc1\u4e66\u7684\u6838\u5fc3\u5185\u5bb9\u6781\u4e3a\u7cbe\u7b80\uff0c\u4ec5\u5305\u542b\u83b7\u5f97\u8005\u59d3\u540d\u3001\u6388\u4e88\u5b66\u4f4d\u540d\u79f0\uff08\u5982Doctor of Philosophy\u7b49\uff09\u3001\u6388\u4e88\u65e5\u671f\u4ee5\u53ca\u5927\u5b66\u6838\u5fc3\u5b98\u5458\u7684\u4eb2\u7b14\u7b7e\u540d\u3002\u7136\u800c\uff0c\u5728\u8fd9\u7b80\u7ea6\u7684\u89c6\u89c9\u80cc\u540e\uff0c\u5374\u9690\u85cf\u7740\u7531\u591a\u79cd\u9876\u5c16\u5370\u5237\u79d1\u6280\u4ea4\u7ec7\u800c\u6210\u7684\u201c\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u9632\u4f2a\u5c42\u7ea7\u201d\u3002</p>"},{"location":"#rmit_1","title":"\u6df1\u5ea6\u89e3\u6790\uff1aRMIT\u6bd5\u4e1a\u8bc1\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u4e0e\u5168\u606f\u9632\u4f2a\u5c42\u7ea7","text":"<p>\u5728\u7269\u7406\u9632\u4f2a\u9886\u57df\uff0c\u201c\u5149\u5b66\u884d\u5c04\u201d\u4e0e\u201c\u6fc0\u5149\u5168\u606f\u201d\u662f\u5bf9\u6297\u9ad8\u7cbe\u5ea6\u590d\u5370\u548c\u6570\u7801\u4f2a\u9020\u7684\u6700\u5f3a\u5229\u5668\u3002\u5728\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u7684\u73b0\u4ee3\u6bd5\u4e1a\u8bc1\u4e66\u4e0a\uff0c\u8fd9\u4e00\u6280\u672f\u88ab\u5de7\u5999\u5730\u878d\u5408\u5728\u7279\u5b9a\u7684\u89c6\u89c9\u951a\u70b9\u4e2d\u3002</p>"},{"location":"#1-dovid","title":"1. \u52a8\u6001\u5149\u5b66\u884d\u5c04\u56fe\u5f62\uff08DOVID\uff09","text":"<p>\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u7684\u6838\u5fc3\u5728\u4e8e\u5229\u7528\u7eb3\u7c73\u7ea7\u7684\u5fae\u7ed3\u6784\u53bb\u63a7\u5236\u5149\u7ebf\u7684\u53cd\u5c04\u4e0e\u6298\u5c04\u3002\u5f53\u5149\u7ebf\u7167\u5c04\u5728\u8bc1\u4e66\u7279\u5b9a\u7684\u9632\u4f2a\u533a\u57df\uff08\u5982\u53f3\u4e0b\u89d2\u7684\u4e13\u7528\u9632\u4f2a\u6807\u8bc6\uff09\u65f6\uff0c\u968f\u7740\u89c6\u89d2\u7684\u503e\u659c\uff0c\u89c2\u5bdf\u8005\u53ef\u4ee5\u6e05\u6670\u5730\u770b\u5230\u8272\u5f69\u6e10\u53d8\u4e0e\u56fe\u5f62\u91cd\u7ec4\u7684\u52a8\u6001\u89c6\u89c9\u6548\u679c\u3002\u8fd9\u79cd\u6280\u672f\u65e0\u6cd5\u901a\u8fc7\u666e\u901a\u7684\u5546\u4e1a\u626b\u63cf\u4eea\u6216\u9ad8\u7cbe\u5ea6\u6570\u7801\u76f8\u673a\u8fdb\u884c\u4e00\u6bd4\u4e00\u7684\u8272\u5f69\u6355\u6349\uff0c\u56e0\u4e3a\u626b\u63cf\u4eea\u53ea\u80fd\u8bb0\u5f55\u5355\u4e00\u89d2\u5ea6\u7684\u9759\u6001\u53cd\u5c04\uff0c\u4ece\u800c\u5728\u590d\u5370\u4ef6\u4e0a\u5448\u73b0\u51fa\u6697\u6de1\u65e0\u5149\u3001\u5931\u53bb\u52a8\u6001\u95ea\u70c1\u611f\u7684\u6b7b\u677f\u8272\u5757\u3002</p>"},{"location":"#2-microtext","title":"2. \u591a\u5c42\u6b21\u5fae\u7c73\u7ea7\u5fae\u7f29\u6587\u5b57\uff08Microtext\uff09","text":"<p>\u5728\u76fe\u5fbd\u7684\u8fb9\u7f18\u7ebf\u3001\u8bc1\u4e66\u7684\u8fb9\u6846\u5e95\u7eb9\u6216\u8005\u7279\u5b9a\u6392\u7248\u7ebf\u6761\u4e2d\uff0cRMIT\u5f15\u5165\u4e86\u9ad8\u9636\u5fae\u7f29\u6587\u5b57\u9632\u4f2a\u3002\u8fd9\u4e9b\u770b\u4f3c\u666e\u901a\u7ebf\u6761\u7684\u89c6\u89c9\u5143\u7d20\uff0c\u572840\u500d\u4ee5\u4e0a\u7684\u653e\u5927\u955c\u4e0b\uff0c\u5b9e\u9645\u4e0a\u662f\u7531\u6781\u5176\u5fae\u5c0f\u7684\u201cRMIT UNIVERSITY\u201d\u5b57\u6837\u8fde\u7eed\u6392\u5217\u800c\u6210\u3002\u8fd9\u79cd\u7cbe\u7ec6\u5ea6\u5bf9\u5370\u5237\u8bbe\u5907\u7684\u89e3\u6790\u5ea6\u8981\u6c42\u6781\u9ad8\uff0c\u666e\u901a\u7684\u5546\u4e1a\u5236\u7248\u548c\u6570\u7801\u6fc0\u5149\u6253\u5370\u673a\u4f1a\u56e0\u4e3a\u58a8\u6c34\u6655\u67d3\u6216\u7269\u7406\u70b9\u9635\u9650\u5236\uff0c\u5bfc\u81f4\u5fae\u7f29\u6587\u5b57\u7cca\u6210\u4e00\u7247\uff0c\u6210\u4e3a\u4e00\u6761\u65e0\u6cd5\u8fa8\u8ba4\u7684\u7c97\u7cd9\u5b9e\u7ebf\u3002</p>"},{"location":"#3","title":"3. \u591a\u8272\u590d\u5408\u91cd\u53e0\u70eb\u91d1\u4e0e\u6fc0\u5149\u956d\u5c04\u6280\u672f","text":"<p>\u89c2\u5bdfRMIT\u7684\u5fbd\u6807\u548c\u7279\u5b9a\u6807\u8bc6\u53ef\u4ee5\u53d1\u73b0\uff0c\u5176\u70eb\u91d1\u5de5\u827a\u975e\u666e\u901a\u7684\u5e73\u9762\u9633\u6587\u70eb\u5370\u3002\u5b83\u91c7\u7528\u4e86\u52a8\u6001\u5168\u606f\u956d\u5c04\u914d\u5408\u591a\u8272\u590d\u5408\u91cd\u53e0\u6280\u672f\u3002\u5728\u5149\u7ebf\u6d41\u8f6c\u4e0b\uff0c\u91d1\u5c5e\u5c42\u5185\u90e8\u4f1a\u6620\u5c04\u51fa\u7ec6\u5bc6\u7684\u5f69\u8272\u884d\u5c04\u6761\u7eb9\uff0c\u5177\u6709\u6781\u5f3a\u7684\u7a7a\u95f4\u5c42\u6b21\u611f\u4e0e\u91d1\u5c5e\u6d41\u5149\u8d28\u611f\uff0c\u8fd9\u662f\u666e\u901a\u70ed\u70eb\u5370\u7b94\u5b8c\u5168\u65e0\u6cd5\u6a21\u62df\u7684\u79d1\u6280\u5c42\u7ea7\u3002</p>"},{"location":"#_1","title":"\u89e6\u89c9\u4e0e\u89c6\u89c9\u7684\u4ea4\u7ec7\uff1a\u53f3\u4fa7\u51f8\u538b\u94a2\u5370\u4e0e\u7ea2\u8272\u6821\u5370\u5de5\u827a","text":"<p>\u9664\u4e86\u9ad8\u5c16\u7aef\u7684\u5149\u5b66\u9632\u4f2a\uff0c\u4f20\u7edf\u7684\u7269\u7406\u89e6\u89c9\u548c\u91cd\u8d28\u611f\u9632\u4f2a\u540c\u6837\u662fRMIT\u6bd5\u4e1a\u8bc1\u7684\u4e00\u5927\u786c\u6838\u7279\u8272\u3002\u5728\u8bc1\u4e66\u53f3\u4e0b\u89d2\u663e\u8457\u4f4d\u7f6e\uff0c\u5927\u5b66\u8bbe\u8ba1\u4e86\u6781\u5177\u8fa8\u8bc6\u5ea6\u7684\u7ea2\u8272\u5706\u5f62\u51f8\u538b\u5927\u5b66\u6821\u5370\uff08University Seal\uff09\u3002</p>"},{"location":"#1","title":"1. \u673a\u68b0\u91cd\u538b\u7acb\u4f53\u6d6e\u96d5\u7ed3\u6784","text":"<p>\u8fd9\u4e00\u7ea2\u8272\u7684\u5706\u76d8\u5e76\u975e\u666e\u901a\u7684\u6cb9\u58a8\u5370\u5237\uff0c\u800c\u662f\u901a\u8fc7\u7cbe\u5bc6\u96d5\u523b\u7684\u91d1\u5c5e\u51f9\u51f8\u9634\u9633\u7248\uff0c\u5728\u91cd\u88c5\u673a\u68b0\u538b\u529b\u4e0b\u76f4\u63a5\u4f5c\u7528\u4e8e\u9632\u4f2a\u7eb8\u5f20\u4e4b\u4e0a\u3002\u7528\u624b\u89e6\u6478\u8bc1\u4e66\u80cc\u9762\uff0c\u53ef\u4ee5\u6e05\u6670\u5730\u611f\u53d7\u5230\u6df1\u51f9\u7684\u673a\u68b0\u538b\u75d5\uff1b\u800c\u6b63\u9762\u5219\u5448\u73b0\u51fa\u9971\u6ee1\u3001\u5706\u6da6\u4e14\u8fb9\u754c\u6781\u5176\u9510\u5229\u7684\u7acb\u4f53\u6d6e\u96d5\u56fe\u6848\u3002\u56fe\u6848\u5185\u90e8\u7684\u7ec6\u5c0f\u7ebf\u6761\u548c\u82f1\u6587\u5b57\u6bcd\u6587\u5b57\u7acb\u4f53\u611f\u6781\u5f3a\uff0c\u751a\u81f3\u5728\u4fa7\u5149\u4e0b\u80fd\u4ea7\u751f\u81ea\u7136\u7684\u5fae\u9634\u5f71\u6548\u679c\u3002</p>"},{"location":"#2","title":"2. \u4e13\u8272\u6cb9\u58a8\u4e0e\u590d\u5408\u5e95\u7eb9\u9632\u4f2a","text":"<p>\u8be5\u7ea2\u8272\u6821\u5370\u6240\u4f7f\u7528\u7684\u4e13\u8272\u6cb9\u58a8\u5177\u6709\u6781\u9ad8\u7684\u8010\u5149\u6027\u4e0e\u9632\u5316\u5b66\u6eb6\u5242\u6d82\u6539\u7279\u6027\u3002\u4e0e\u4e4b\u76f8\u914d\u5408\u7684\uff0c\u662f\u8bc1\u4e66\u80cc\u666f\u4e2d\u6781\u5176\u6de1\u96c5\u4e14\u590d\u6742\u7684\u9632\u4f2a\u9634\u5f71\u5e95\u7eb9\u3002\u8fd9\u4e9b\u5e95\u7eb9\u7531\u6570\u5b66\u66f2\u7ebf\uff08\u65ad\u7ebf\u3001\u626d\u66f2\u6ce2\u6d6a\u7ebf\uff09\u6784\u6210\uff0c\u4e00\u65e6\u906d\u5230\u626b\u63cf\u590d\u5370\uff0c\u4f1a\u89e6\u53d1\u201c\u83ab\u5c14\u6761\u7eb9\uff08Moir\u00e9 patterns\uff09\u201d\u6548\u5e94\uff0c\u4f7f\u590d\u5370\u4ef6\u4e0a\u51fa\u73b0\u660e\u663e\u7684\u201cCOPY\u201d\u6216\u7f51\u683c\u5e72\u6270\u6591\u7eb9\u3002</p>"},{"location":"#_2","title":"\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u6bd5\u4e1a\u8bc1\u771f\u4f2a\u67e5\u8be2\u4e0e\u5b98\u65b9\u6570\u5b57\u53cc\u8f68\u9a8c\u8bc1","text":"<p>\u5728\u4fe1\u606f\u5316\u65f6\u4ee3\uff0c\u5355\u9760\u7269\u7406\u9632\u4f2a\u5df2\u65e0\u6cd5\u5b8c\u5168\u6ee1\u8db3\u73b0\u4ee3\u4f01\u4e1a\u5bf9\u4e8e\u9ad8\u6548\u7387\u3001\u96f6\u98ce\u9669\u7684\u4eba\u624d\u6d41\u5411\u5ba1\u6838\u9700\u6c42\u3002\u56e0\u6b64\uff0c\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u6784\u5efa\u4e86\u5b8c\u5584\u7684\u201c\u7269\u7406\u6587\u51ed+\u5b98\u65b9\u6570\u5b57\u51ed\u8bc1\u201d\u53cc\u8f68\u9a8c\u8bc1\u4f53\u7cfb\u3002\u8fd9\u4e5f\u662f\u767e\u5ea6\u548c\u8c37\u6b4c\u8d8b\u52bf\u4e0a\uff0c\u201cRMIT\u5b66\u5386\u7559\u670d\u8ba4\u8bc1\u201d\u3001\u201cRMIT\u6bd5\u4e1a\u8bc1\u771f\u4f2a\u67e5\u8be2\u201d\u7b49\u8bcd\u6761\u641c\u7d22\u91cf\u5c45\u9ad8\u4e0d\u4e0b\u7684\u4e3b\u56e0\u3002</p>"},{"location":"#1-my-equals","title":"1. My eQuals \u5168\u7403\u6570\u5b57\u5316\u5408\u89c4\u5171\u4eab\u5e73\u53f0","text":"<p>\u9488\u5bf92005\u5e74\u53ca\u4ee5\u540e\u6bd5\u4e1a\u7684\u6240\u6709RMIT\u5b66\u751f\uff0c\u5927\u5b66\u5168\u9762\u63a5\u5165\u4e86My eQuals\uff08\u6fb3\u6d32\u4e0e\u65b0\u897f\u5170\u9ad8\u6821\u5b98\u65b9\u8ba4\u8bc1\u7684\u6570\u5b57\u5316\u8054\u5408\u5e73\u53f0\uff09\u3002 * \u7ec8\u8eab\u8bbf\u95ee\u4e0e\u4e0d\u53ef\u7be1\u6539\u6027\uff1a\u6bd5\u4e1a\u751f\u53ef\u4ee5\u901a\u8fc7\u4e2a\u4eba\u7684Enrolment Online\u6ce8\u518c\u6c38\u4e45\u7684My eQuals\u8d26\u6237\uff0c\u5e73\u53f0\u4f1a\u76f4\u63a5\u751f\u6210\u5e26\u6709\u6570\u5b57\u7b7e\u540d\u3001\u53d7\u6cd5\u5f8b\u4fdd\u62a4\u4e14\u4e0d\u53ef\u7be1\u6539\u7684\u52a0\u5bc6PDF\u7248\u672c\u5b66\u672f\u62a5\u544a\u3001\u6210\u7ee9\u5355\u53ca\u6bd5\u4e1a\u8bc1\u4e66\u3002 * \u7b2c\u4e09\u65b9\u4e00\u952e\u9a8c\u8bc1\uff1a\u5f53\u96c7\u4e3b\u3001\u6d77\u5916\u9ad8\u6821\u6216\u8ba4\u8bc1\u673a\u6784\u9700\u8981\u6838\u5b9e\u5b66\u5386\u65f6\uff0c\u5b66\u751f\u53ea\u9700\u901a\u8fc7My eQuals\u7cfb\u7edf\u53d1\u9001\u4e00\u6839\u5408\u89c4\u7684\u5b98\u65b9\u5171\u4eab\u94fe\u63a5\u3002\u63a5\u6536\u65b9\u53ef\u4ee5\u76f4\u63a5\u5728My eQuals\u5b98\u65b9\u670d\u52a1\u5668\u4e0a\u67e5\u770b\u5e76\u4e0b\u8f7d\u7ecf\u8fc7\u8ba4\u8bc1\u7684\u7535\u5b50\u6863\u6848\u3002\u4efb\u4f55\u5bf9\u6587\u4ef6\u7684\u6076\u610f\u7be1\u6539\u90fd\u4f1a\u5bfc\u81f4\u6570\u5b57\u8bc1\u4e66\u5931\u6548\u3002</p>"},{"location":"#2-graduate-verification-service-gvs","title":"2. \u6bd5\u4e1a\u751f\u6838\u5b9e\u670d\u52a1\uff08Graduate Verification Service, GVS\uff09","text":"<p>\u5bf9\u4e8e\u96c7\u4e3b\u6216\u80cc\u8c03\u516c\u53f8\uff0cRMIT\u63d0\u4f9b\u4e86\u4e13\u6709\u7684\u7ebf\u4e0a\u6838\u5b9e\u6e20\u9053\u3002\u5728\u83b7\u5f97\u6bd5\u4e1a\u751f\u660e\u786e\u6388\u6743\u7684\u524d\u63d0\u4e0b\uff0c\u673a\u6784\u53ef\u4ee5\u901a\u8fc7RMIT\u7684\u5b98\u65b9\u6e20\u9053\u63d0\u4ea4\u6821\u53cb\u59d3\u540d\u3001\u51fa\u751f\u65e5\u671f\u3001\u5b66\u4f4d\u540d\u79f0\u53ca\u6bd5\u4e1a\u5e74\u4efd\u3002\u5b66\u6821\u7cfb\u7edf\u4f1a\u81ea\u52a8\u6bd4\u5bf9\u81ea1900\u5e74\u4ee3\u4ee5\u6765\u7684\u5168\u91cf\u5b66\u7c4d\u6570\u636e\u5e93\uff0c\u5e76\u5728\u6570\u4e2a\u5de5\u4f5c\u65e5\u5185\u51fa\u5177\u5177\u6709\u6cd5\u5f8b\u6548\u529b\u7684\u5b98\u65b9\u6838\u5b9e\u786e\u8ba4\u51fd\uff08Award Verification Request\uff09\u3002\u82e5\u6d89\u53ca\u66f4\u6df1\u5c42\u6b21\u7684\u5728\u6821\u8868\u73b0\u6838\u5b9e\uff08\u5982\u51fa\u52e4\u65f6\u95f4\u7b49\uff09\uff0c\u5219\u5fc5\u987b\u63d0\u4ea4\u5305\u542b\u5b66\u751f\u4eb2\u7b14\u7269\u7406\u7b7e\u540d\u7684\u6388\u6743\u4e66\uff08Part C: Student Authorisation\uff09\u3002</p>"},{"location":"#dfat","title":"\u56fd\u5185\u5916\u5408\u89c4\u4f7f\u7528\u6307\u5f15\uff1a\u7559\u670d\u8ba4\u8bc1\u4e0eDFAT\u9886\u4e8b\u8ba4\u8bc1\u6d41\u7a0b","text":"<p>\u5bf9\u4e8e\u4e2d\u56fd\u7559\u5b66\u751f\u800c\u8a00\uff0c\u987a\u5229\u62ff\u5230\u542b\u6709\u9ad8\u9636\u9632\u4f2a\u7684\u7269\u7406\u6bd5\u4e1a\u8bc1\u4ec5\u4ec5\u662f\u7b2c\u4e00\u6b65\uff0c\u8981\u5728\u4e2d\u56fd\u56fd\u5185\u7684\u56fd\u4f01\u3001\u4e8b\u4e1a\u5355\u4f4d\u3001\u9ad8\u7b49\u9662\u6821\u53ca\u843d\u6237\u7533\u8bf7\u4e2d\u53d1\u6325\u6548\u529b\uff0c\u5fc5\u987b\u8d70\u5b8c\u5408\u89c4\u7684\u56fd\u9645\u8ba4\u8bc1\u6d41\u7a0b\u3002</p>"},{"location":"#1-cscse","title":"1. \u4e2d\u56fd\u7559\u670d\u8ba4\u8bc1\uff08CSCSE\uff09\u6807\u51c6\u89c4\u8303","text":"<p>\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08\u7559\u670d\u4e2d\u5fc3\uff09\u662f\u56fd\u5185\u552f\u4e00\u6743\u5a01\u7684\u6d77\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u673a\u6784\u3002\u7531\u4e8eRMIT\u662f\u6fb3\u5927\u5229\u4e9a\u6b63\u89c4\u7684\u9ad8\u7b49\u6559\u80b2\u673a\u6784\uff0c\u5176\u5b66\u672f\u5b66\u4f4d\u5b8c\u5168\u5728\u56fd\u5185\u6559\u80b2\u90e8\u7684\u8ba4\u53ef\u540d\u5f55\u5185\u3002\u6bd5\u4e1a\u751f\u53ea\u9700\u767b\u5f55\u7559\u670d\u4e2d\u5fc3\u7f51\u4e0a\u670d\u52a1\u5927\u5385\uff0c\u4e0a\u4f20\u5e26\u6709\u6e05\u6670\u9632\u4f2a\u7279\u5f81\u7684\u6bd5\u4e1a\u8bc1\u4e66\u626b\u63cf\u4ef6\u3001\u6210\u7ee9\u5355\u3001\u62a4\u7167\u7b7e\u8bc1\u8bb0\u5f55\u4ee5\u53ca\u6388\u6743\u58f0\u660e\uff0c\u5373\u53ef\u5728\u7ebf\u5b8c\u6210\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u3002\u8ba4\u8bc1\u7ed3\u679c\u5728\u7559\u670d\u4e2d\u5fc3\u7f51\u7ad9100%\u6c38\u4e45\u53ef\u67e5\uff0c\u662f\u56de\u56fd\u53d1\u5c55\u7684\u57fa\u77f3\u3002</p>"},{"location":"#2-dfat-apostille","title":"2. \u56fd\u9645\u6cd5\u5236\u5316\uff08DFAT Apostille \u6d77\u7259\u8ba4\u8bc1\u4e0e\u9886\u4e8b\u8ba4\u8bc1\uff09","text":"<p>\u82e5RMIT\u7684\u6bd5\u4e1a\u6587\u51ed\u9700\u8981\u63d0\u4ea4\u7ed9\u9664\u4e2d\u56fd\u3001\u6fb3\u6d32\u4ee5\u5916\u7684\u5176\u4ed6\u6d77\u5916\u653f\u5e9c\u6216\u8de8\u56fd\u673a\u6784\u4f7f\u7528\uff0c\u5f80\u5f80\u9700\u8981\u8fdb\u884c\u6587\u51ed\u7684\u6cd5\u5236\u5316\u3002 * \u7b2c\u4e00\u6b65\uff1a\u5b66\u6821\u516c\u8bc1\uff1a\u5c06\u6e05\u6670\u7684\u6587\u6863PDF\u6216My eQuals\u7535\u5b50\u51ed\u8bc1\u63d0\u4ea4\u81f3RMIT\u6559\u52a1\u957f\u7535\u5b50\u90ae\u7bb1\uff08academic.registrar@rmit.edu.au\uff09\u8fdb\u884c\u5b66\u672f\u771f\u5b9e\u6027\u80cc\u4e66\u3002 * \u7b2c\u4e8c\u6b65\uff1a\u5916\u4ea4\u8d38\u6613\u90e8\u8ba4\u8bc1\uff1a\u7531\u6fb3\u5927\u5229\u4e9a\u5916\u4ea4\u8d38\u6613\u90e8\uff08DFAT\uff09\u6216\u901a\u8fc7Smartraveller\u9884\u7ea6\uff0c\u5bf9\u5df2\u6838\u5b9e\u7684\u6587\u51ed\u52a0\u76d6\u6d77\u7259\u8ba4\u8bc1\u7b7e\u6761\uff08Apostille\uff09\u6216\u8fdb\u884c\u4f20\u7edf\u9886\u4e8b\u8ba4\u8bc1\uff08Authentication\uff09\u3002\u8fd9\u4e00\u6d41\u7a0b\u786e\u4fdd\u4e86\u6587\u51ed\u5728\u56fd\u9645\u6cd5\u7406\u5c42\u9762\u7684\u6700\u9ad8\u5408\u89c4\u6027\u3002</p>"},{"location":"#_3","title":"\u603b\u7ed3\uff1a\u5b88\u62a4\u5b66\u672f\u5c0a\u4e25\u7684\u79d1\u6280\u9632\u7ebf","text":"<p>\u6bcf\u4e00\u5f20\u7687\u5bb6\u58a8\u5c14\u672c\u7406\u5de5\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff0c\u4e0d\u4ec5\u627f\u8f7d\u7740\u5b66\u5b50\u6570\u5e74\u6311\u706f\u591c\u6218\u7684\u6c57\u6c34\u4e0e\u667a\u6167\uff0c\u4e5f\u662f\u5927\u5b66\u672c\u8eab\u5b66\u672f\u58f0\u8a89\u7684\u5ef6\u5c55\u3002\u4ece\u7279\u5236\u8bc1\u5238\u7eb8\u7684\u9009\u62e9\uff0c\u5230\u9ad8\u9636\u5149\u5b66\u884d\u5c04\u5c42\u7ea7\u3001\u5fae\u7f29\u6587\u5b57\u3001\u91cd\u8d28\u7ea2\u5370\u6d6e\u96d5\u7684\u53e0\u52a0\uff0c\u518d\u5230My eQuals\u6570\u5b57\u9632\u706b\u5899\u7684\u7b51\u8d77\uff0cRMIT\u901a\u8fc7\u5c16\u7aef\u79d1\u6280\u5c06\u7269\u7406\u4e16\u754c\u4e0e\u6570\u5b57\u4e16\u754c\u7684\u9632\u4f2a\u7f51\u7edc\u5b8c\u7f8e\u4ea4\u7ec7\u3002</p> <p>\u4e86\u89e3\u5e76\u638c\u63e1\u8fd9\u4e9b\u9ad8\u9636\u9632\u4f2a\u7279\u5f81\u4e0e\u5408\u89c4\u9a8c\u8bc1\u6d41\u7a0b\uff0c\u4e0d\u4ec5\u80fd\u5e2e\u52a9\u7528\u4eba\u5355\u4f4d\u5728\u77ac\u606f\u4e07\u53d8\u7684\u4eba\u624d\u5e02\u573a\u4e2d\u7cbe\u51c6\u8bc6\u522b\u771f\u624d\u5b9e\u5b66\uff0c\u66f4\u80fd\u6709\u6548\u4fdd\u969c\u5e7f\u5927\u6b63\u89c4\u7559\u5b66\u751f\u7684\u5408\u6cd5\u6743\u76ca\uff0c\u5171\u540c\u5b88\u62a4\u9ad8\u7b49\u6559\u80b2\u7684\u7eaf\u6d01\u6027\u4e0e\u795e\u5723\u5c0a\u4e25\u3002</p>"}]}